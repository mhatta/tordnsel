# systemd unit for TorDNSEL.
#
# Install as /etc/systemd/system/tordnsel.service. TorDNSEL runs as the
# unprivileged "tordnsel" user from the start (so don't set User, Group or
# ChangeRootDirectory in tordnsel.conf); CAP_NET_BIND_SERVICE lets it bind
# port 53 (and port 80 for the HTTP interface or exit tests). In
# /etc/tordnsel.conf, use:
#
#   StateDirectory /var/lib/tordnsel
#   RuntimeDirectory /run/tordnsel
#   RunAsDaemon False
#   Log notice syslog
#
# To authenticate to Tor with its cookie, make the cookie group-readable
# (CookieAuthFileGroupReadable 1 in the torrc) and add Tor's group below,
# e.g. SupplementaryGroups=debian-tor on Debian.

[Unit]
Description=TorDNSEL, a DNS-based list of Tor exit nodes
Documentation=man:tordnsel(8)
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=tordnsel
Group=tordnsel
#SupplementaryGroups=debian-tor
ExecStartPre=/usr/local/bin/tordnsel -f /etc/tordnsel.conf --verify-config
ExecStart=/usr/local/bin/tordnsel -f /etc/tordnsel.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
StateDirectory=tordnsel
RuntimeDirectory=tordnsel
LimitNOFILE=16384

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
